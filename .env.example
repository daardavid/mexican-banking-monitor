# Copy this file to .env on each laptop. Never commit .env.
MBM_ENV=development
MBM_LOG_LEVEL=INFO

# Use the Supabase transaction pooler connection string for CI/serverless jobs.
# Example only; replace every placeholder locally.
MBM_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Public dashboard access. These values may be exposed only after RLS is enabled.
MBM_SUPABASE_URL=https://PROJECT_REF.supabase.co
MBM_SUPABASE_PUBLISHABLE_KEY=replace-me

# Server-side only. Required by the ingestion job; never expose in Streamlit code.
MBM_SUPABASE_SERVICE_ROLE_KEY=replace-me
